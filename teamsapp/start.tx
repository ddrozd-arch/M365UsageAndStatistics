public interface IAdGroupResolver
{
    Task<List<string>> GetGroupsAsync(string user);
}

public class AdGroupResolver : IAdGroupResolver
{
    public Task<List<string>> GetGroupsAsync(string user)
    {
        // Placeholder — tu będzie prawdziwe AD
        return Task.FromResult(new List<string>
        {
            "CONTOSO\\App_Users"
        });
    }
}


