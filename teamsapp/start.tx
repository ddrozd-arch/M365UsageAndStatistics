🟦 2. AppConfig.cs

public class AppConfig
{
    public string AppId { get; set; }
    public string Secret { get; set; }
    public string TenantId { get; set; }
    public string Thumbprint { get; set; }
    public string LogDir { get; set; }
    public string DataDir { get; set; }
